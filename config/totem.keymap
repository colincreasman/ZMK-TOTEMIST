// TOTEM board wrapper for urob's shared base.keymap.
//
// The TOTEM is a wireless 38-key split. Relative to urob's 34-key base it has
// two extra bottom-row outer pinky keys and a third thumb per hand. Following
// urob's Corneish Zen mapping, the extra outer thumbs become an always-on
// &kp LGUI (left) and &smart_mouse toggle (right). The two spare bottom-outer
// pinkies hold &none (left) and apostrophe (right) — the latter re-homes the
// SQT that QWERTY displaces from the top row.

#define CONFIG_WIRELESS

#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH)                   \
    ZMK_LAYER(                                                                 \
        name,                                                                  \
                 LT RT                                                         \
                 LM RM                                                         \
        &none    LB RB    &kp SQT                                             \
        &kp LGUI LH RH &smart_mouse                                            \
    )

#include "totem.h"
#include "base.keymap"
